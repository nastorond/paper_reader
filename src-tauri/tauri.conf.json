{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperBoard",
  "version": "0.1.0",
  "identifier": "com.paperboard.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperBoard",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNzRENjQ1MTFENjRDNTgKUldSWVROWVJSZFowK2ttZzQyMjNXY0ZnWTNMZnFHSUNVWnliVVZGSzRyZU5qUTlod1lLK0lieUkK",
      "endpoints": [
        "https://github.com/nastorond/paper_reader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
